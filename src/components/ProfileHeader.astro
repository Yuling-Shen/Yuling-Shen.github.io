---
import type { Profile } from "../data/schema";
import { withBase } from "../lib/urls";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<header class="profile-header">
  <div class="profile-portrait">
    <img
      src={withBase("images/profile.jpg")}
      alt={`Portrait of ${profile.name}`}
      width="112"
      height="136"
    />
  </div>
  <div class="profile-copy">
    <h1>{profile.name}</h1>
    <p class="appointment">
      {profile.role}, {profile.unit}, {profile.institution}, {profile.country}
      <span class="supporting">{" \u00b7 "}{profile.appointmentDates}</span>
    </p>
    <p class="supporting">
      {[profile.locality, profile.region, profile.country].join(", ")}
    </p>
    <ul class="education-list" aria-label="Education">
      {
        profile.education.map((item) => (
          <li>
            <strong>{item.degree}</strong>, {item.institution}
            <span class="supporting">{" \u00b7 "}{item.completed}</span>
          </li>
        ))
      }
    </ul>
    <p class="advisor-line">
      <strong>Advisors:</strong>{" "}
      {
        profile.advisors.map((advisor, index) => (
          <>
            {index > 0 && " · "}
            <a href={advisor.url}>{advisor.name}</a>
          </>
        ))
      }
    </p>
    <div class="profile-links">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <a href={profile.scholarUrl}>Google Scholar</a>
    </div>
  </div>
</header>
